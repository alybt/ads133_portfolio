{
    "require": {
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "src/"
        ],
        "files": [
            "src/config/config.php",
            "src/Support/helpers.php"
        ],
        "config": {
            "optimize-autoloader": true,
            "classmap-authoritative": true
        }
    }
    
}





